# Sourced by the other scripts in bin/. Sets up gh and git to act as discourse-dep-bot.
#
# Usage: source bin/bot-env TOKEN_FILE

token_file="${1:?TOKEN_FILE is required}"
[[ -r "$token_file" ]] || { echo "Cannot read $token_file" >&2; exit 1; }
GH_TOKEN="$(tr -d '[:space:]' < "$token_file")"
export GH_TOKEN
export GH_REPO=discourse/discourse

# git asks gh for credentials, and gh answers with GH_TOKEN, so the token is never written to disk.
# The empty values clear any credential helpers configured elsewhere.
export GIT_CONFIG_COUNT=3
export GIT_CONFIG_KEY_0="credential.helper" GIT_CONFIG_VALUE_0=""
export GIT_CONFIG_KEY_1="credential.https://github.com.helper" GIT_CONFIG_VALUE_1=""
export GIT_CONFIG_KEY_2="credential.https://github.com.helper" GIT_CONFIG_VALUE_2="!gh auth git-credential"

bot_login="$(gh api user --jq .login)"
bot_id="$(gh api user --jq .id)"
export GIT_AUTHOR_NAME="$bot_login" GIT_COMMITTER_NAME="$bot_login"
export GIT_AUTHOR_EMAIL="$bot_id+$bot_login@users.noreply.github.com"
export GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"

bot_fork="https://github.com/discourse-dep-bot/discourse"
