#!/usr/bin/env bash
# Runs the dependency bot every 15 minutes, each run in a fresh directory.
#
# Usage: bin/run-loop TOKEN_FILE
#
# TOKEN_FILE holds a classic personal access token for discourse-dep-bot with
# the `public_repo` (or `repo`) and `workflow` scopes.
#
# Environment:
#   DEP_BOT_INTERVAL   seconds between the starts of two runs (default 900)
#   DEP_BOT_TIMEOUT    longest a single run may take (default 110m, less than the state lease)
#   DEP_BOT_LOG_DIR    where each run's output goes (default ~/.local/state/dep-bot)
#
# Needs git, gh, claude, Ruby with Bundler, and Node with pnpm on PATH.
set -euo pipefail

token_file="${1:?Usage: bin/run-loop TOKEN_FILE}"
interval="${DEP_BOT_INTERVAL:-900}"
run_timeout="${DEP_BOT_TIMEOUT:-110m}"
log_dir="${DEP_BOT_LOG_DIR:-$HOME/.local/state/dep-bot}"
fork="https://github.com/discourse-dep-bot/discourse"
prompt="Do this run of the dependency bot, following the discourse-dependency-updates skill."

[[ -r "$token_file" ]] || { echo "Cannot read $token_file" >&2; exit 1; }
GH_TOKEN="$(tr -d '[:space:]' < "$token_file")"
export GH_TOKEN
export GH_REPO=discourse/discourse

# git asks gh for credentials, and gh answers with GH_TOKEN, so the token is never written to disk.
# The empty values clear any credential helpers configured elsewhere.
export GIT_CONFIG_COUNT=3
export GIT_CONFIG_KEY_0="credential.helper" GIT_CONFIG_VALUE_0=""
export GIT_CONFIG_KEY_1="credential.https://github.com.helper" GIT_CONFIG_VALUE_1=""
export GIT_CONFIG_KEY_2="credential.https://github.com.helper" GIT_CONFIG_VALUE_2="!gh auth git-credential"

login="$(gh api user --jq .login)"
id="$(gh api user --jq .id)"
export GIT_AUTHOR_NAME="$login" GIT_COMMITTER_NAME="$login"
export GIT_AUTHOR_EMAIL="$id+$login@users.noreply.github.com" GIT_COMMITTER_EMAIL="$id+$login@users.noreply.github.com"

mkdir -p "$log_dir"
echo "Running as $login every $interval seconds. Logs go to $log_dir."

while true; do
  started=$(date +%s)
  log="$log_dir/$(date -u +%Y%m%dT%H%M%SZ).log"
  run_dir="$(mktemp -d)"

  if (
    cd "$run_dir"
    git clone --quiet --single-branch --branch dep-bot "$fork" bot
    cd bot
    timeout "$run_timeout" claude -p "$prompt" --dangerously-skip-permissions
  ) > "$log" 2>&1; then
    echo "$(date -u +%H:%M:%S) run finished: $log"
  else
    echo "$(date -u +%H:%M:%S) run failed: $log" >&2
  fi

  rm -rf "$run_dir"
  elapsed=$(( $(date +%s) - started ))
  (( elapsed < interval )) && sleep $(( interval - elapsed ))
done
